<?xml version="1.0"?>
<package format="3">
  <name>yolo_msgs</name>
  <version>0.0.1</version>
  <description>
    Minimal YOLO detection message definitions for NTU COMP30271 JetBot.
    Compatible with ROS2 Eloquent.  Used by jetbot_wall_follower.py,
    jetbot_landmark_csv_logger.py, and jetbot_yolo_detector.py.
  </description>
  <maintainer email="student@ntu.ac.uk">NTU Student</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
